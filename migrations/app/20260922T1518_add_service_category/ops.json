[
  {
    "id": "table.appointment",
    "label": "Create table \"appointment\"",
    "summary": "Creates table \"appointment\"",
    "operationClass": "additive",
    "target": {
      "id": "postgres",
      "details": {
        "schema": "public",
        "objectType": "table",
        "name": "appointment"
      }
    },
    "precheck": [
      {
        "description": "ensure table \"appointment\" does not exist",
        "sql": "SELECT (to_regclass($1)) IS NULL AS \"result\"",
        "params": [
          "\"public\".\"appointment\""
        ]
      }
    ],
    "execute": [
      {
        "description": "create table \"appointment\"",
        "sql": "CREATE TABLE \"public\".\"appointment\" (\n  \"appointmentDate\" text NOT NULL,\n  \"appointmentTime\" text NOT NULL,\n  \"createdAt\" timestamptz DEFAULT (now()) NOT NULL,\n  \"id\" SERIAL NOT NULL,\n  \"message\" text,\n  \"name\" text NOT NULL,\n  \"phone\" text NOT NULL,\n  \"service\" text NOT NULL,\n  \"status\" text DEFAULT 'PENDING' NOT NULL,\n  \"updatedAt\" timestamptz NOT NULL,\n  PRIMARY KEY (\"id\")\n)",
        "params": []
      }
    ],
    "postcheck": [
      {
        "description": "verify table \"appointment\" exists",
        "sql": "SELECT (to_regclass($1)) IS NOT NULL AS \"result\"",
        "params": [
          "\"public\".\"appointment\""
        ]
      }
    ]
  },
  {
    "id": "column.public.service.category",
